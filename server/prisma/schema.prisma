// Nasight schema.
// Grouped into zones (identity, conversation, activity, corpus, metrics) so the
// file stays navigable as it grows.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// NOTE: Prisma 7 has no `url` here. The CLI reads it from prisma.config.ts and
// the runtime gets it through a driver adapter (see src/config/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ─── Identity zone ───────────────────────────────────

enum Role {
  TRAINEE
  ANALYST
  ADMIN
}

// An enum rather than a boolean, so adding states like SUSPENDED later doesn't
// mean reinterpreting what the field means.
enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  // Null for OAuth-only accounts; Google sign-in never sets a password.
  passwordHash String?
  displayName  String
  role         Role       @default(TRAINEE)
  status       UserStatus @default(ACTIVE)
  emailVerified Boolean @default(false)

  // Just the filename. multer writes the file under uploads/avatars/ and it's
  // served statically from there.
  avatarPath String?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthAccounts           OAuthAccount[]
  conversations           Conversation[]
  queryLogs               QueryLog[]
  notifications           Notification[]
  ingestionJobs           IngestionJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // createdAt: admin list ordering, signups-today count, recent signups.
  // status: the blocked count and the status filter.
  @@index([createdAt])
  @@index([status])
  @@map("users")
}

// ─── Conversation zone ───────────────────────────────

enum MessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  pinned   Boolean @default(false)
  archived Boolean @default(false)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matches the sidebar query exactly: filter by user, order by pinned then
  // updatedAt.
  @@index([userId, pinned, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // [{ acn, reportId }] for assistant messages. JSON rather than a join table,
  // because citations are only ever read back with their own message.
  citations      Json?

  createdAt DateTime @default(now())

  // NOTE: the pg_trgm GIN index on `content` used by conversation search is added
  // by hand in the migration SQL. Prisma can't express a trigram GIN.
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── Activity zone ───────────────────────────────────

// A broadcast becomes one row per recipient, so each user has independent read
// state. Fine at this scale; a broadcast table joined to read receipts is the
// move if the user base gets large.
model Notification {
  id     String    @id @default(uuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

enum QueryKind {
  SEARCH
  ASK
}

enum AiOperation {
  EMBEDDING
  CHAT
  REWRITE
  CLASSIFICATION
  SUMMARIZATION
}

// One row per real provider call, for the admin dashboard. Nothing is written
// when the dev fallbacks are in use, since those make no calls.
model TokenUsage {
  id               String      @id @default(uuid())
  operation        AiOperation
  model            String
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)

  createdAt DateTime @default(now())

  @@index([operation, createdAt])
  @@map("token_usage")
}

// The audit log, which doubles as the quota counter: a day's usage is the count
// of rows since midnight UTC. ipAddress is only set for guests, who have no user
// id to count against. Deleting a user anonymizes their logs rather than losing
// the history.
model QueryLog {
  id             String    @id @default(uuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress      String?
  kind           QueryKind
  query          String
  rewrittenQuery String?
  retrievalCount Int       @default(0)
  citedReportIds String[]  @default([])
  latencyMs      Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("query_logs")
}

// Short-lived 6-digit codes, stored as a SHA-256 hash and never in plaintext.
// consumedAt makes a code single-use. Only the newest unconsumed code works: the
// controller consumes the older ones when it issues a new one.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  codeHash   String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

enum OAuthProvider {
  GOOGLE
}

// Links a user to an external identity. Google only for now; the enum leaves
// room for others. A user can have both a password and a linked provider.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String // the provider's stable user id (Google `sub`)
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Same shape as email verification. A successful reset also revokes every
// refresh token, which signs the user out everywhere.
model PasswordResetToken {
  id         String    @id @default(uuid())
  codeHash   String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Corpus zone ─────────────────────────────────────

// A fixed set, so the model can't invent categories. OTHER is the fallback when
// its output doesn't validate.
enum Category {
  HUMAN_FACTORS
  AIRCRAFT_SYSTEMS
  WEATHER
  ATC_COMMUNICATION
  RUNWAY_SAFETY
  WILDLIFE
  PROCEDURAL
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// An admin upload, processed by the worker off the request path. The raw CSV is
// stored on the row because the worker is a separate process with no shared disk.
model IngestionJob {
  id              String    @id @default(uuid())
  uploaderId      String?
  uploader        User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  filename        String
  status          JobStatus @default(QUEUED)
  totalRows       Int       @default(0)
  reportsIngested Int       @default(0)
  chunksCreated   Int       @default(0)
  error           String?
  sourceCsv       String
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("ingestion_jobs")
}

// One ASRS report, kept verbatim so an answer can always be traced back to its
// source. category and severity are assigned at ingestion; summary is generated
// on first view and cached, so unchanged text is never re-summarized.
model Report {
  id         String    @id @default(uuid())
  // ASRS Accession Number, the report's external id. Unique, so re-ingesting the
  // same CSV upserts instead of duplicating.
  acn        String    @unique
  narrative  String
  synopsis   String?
  reportDate DateTime?

  category              Category?
  severity              Severity?
  severityJustification String?
  summary               String?

  chunks ReportChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([severity])
  // The triage list orders by reportDate desc on every load.
  @@index([reportDate])
  @@map("reports")
}

// A slice of a narrative plus its embedding.
// NOTE: `embedding` is Unsupported() because Prisma has no vector type, so it's
// only ever written and read through raw SQL, never the typed client. The HNSW
// index is added by hand in the migration SQL.
model ReportChunk {
  id         String                      @id @default(uuid())
  reportId   String
  report     Report                      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_chunks")
}

// Opaque random strings; only the SHA-256 hash is stored. revokedAt covers logout
// and rotation-on-refresh, expiresAt bounds the session.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Metrics rollup zone ─────────────────────────────

// One tiny row per UTC day, written by the nightly worker. It's what lets the
// dashboard show all-time totals without scanning query_logs and token_usage,
// and it's why those raw tables can be pruned at all. `day` is "YYYY-MM-DD".
model DailyMetric {
  day              String @id
  queriesSearch    Int    @default(0)
  queriesAsk       Int    @default(0)
  tokensTotal      Int    @default(0)
  tokensPrompt     Int    @default(0)
  tokensCompletion Int    @default(0)
  // { EMBEDDING: n, CHAT: n, REWRITE: n, ... }
  tokensByOperation Json  @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_metrics")
}
