// Nasight schema.
// grouped into zones (identity, conversation, activity, corpus, metrics) so it
// stays findable as it grows

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// prisma 7 has no `url` in here any more. the CLI reads it from prisma.config.ts
// and the runtime gets it via a driver adapter, see src/config/prisma.ts
datasource db {
  provider = "postgresql"
}

// ========== identity zone ==================

enum Role {
  TRAINEE
  ANALYST
  ADMIN
}

// an enum not a boolean, so adding SUSPENDED later doesn't mean rethinking what
// the field means
enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  // null for google-only accounts, oauth sign-in never sets a password
  passwordHash String?
  displayName  String
  role         Role       @default(TRAINEE)
  status       UserStatus @default(ACTIVE)
  emailVerified Boolean @default(false)

  // filename only. multer writes the file into uploads/avatars/ and express
  // serves it from there
  avatarPath String?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthAccounts           OAuthAccount[]
  conversations           Conversation[]
  queryLogs               QueryLog[]
  notifications           Notification[]
  ingestionJobs           IngestionJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // createdAt for the admin list order and the signups-today count.
  // status for the blocked count and the status filter
  @@index([createdAt])
  @@index([status])
  @@map("users")
}

// ========= conversation zone ===============

enum MessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  pinned   Boolean @default(false)
  archived Boolean @default(false)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // matches the sidebar query exactly: by user, then pinned, then updatedAt
  @@index([userId, pinned, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // [{ acn, reportId }] on assistant messages. json rather than a join table,
  // citations are only ever read back with the message they belong to
  citations      Json?

  createdAt DateTime @default(now())

  // the pg_trgm GIN index on `content` that conversation search uses is written
  // by hand in the migration SQL, prisma can't express a trigram GIN
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ========== activity zone ============

// a broadcast writes one row per user, so everyone has their own read state.
// fine at this size. if the user base gets big, switch to a broadcast table
// joined to read receipts
model Notification {
  id     String    @id @default(uuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

enum QueryKind {
  SEARCH
  ASK
}

enum AiOperation {
  EMBEDDING
  CHAT
  REWRITE
  CLASSIFICATION
  SUMMARIZATION
}

// one row per real provider call, for the admin dashboard. the dev stubs make no
// calls, so they write nothing in here
model TokenUsage {
  id               String      @id @default(uuid())
  operation        AiOperation
  model            String
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)

  createdAt DateTime @default(now())

  @@index([operation, createdAt])
  @@map("token_usage")
}

// the audit log, doubling as the quota counter. a day's usage is just a count of
// rows since midnight UTC. ipAddress is only set for guests, they've got no user
// id to count against. deleting a user nulls the link instead of dropping the rows
model QueryLog {
  id             String    @id @default(uuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress      String?
  kind           QueryKind
  query          String
  rewrittenQuery String?
  retrievalCount Int       @default(0)
  citedReportIds String[]  @default([])
  latencyMs      Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("query_logs")
}

// short-lived 6-digit codes, stored as a sha256 hash, never in plaintext.
// consumedAt makes them single use, and only the newest one works because the
// controller burns the older ones when it issues a new one
model EmailVerificationToken {
  id         String    @id @default(uuid())
  codeHash   String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

enum OAuthProvider {
  GOOGLE
}

// links a user to an external identity. google only right now, the enum leaves
// room for more. someone can have both a password and a linked provider
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String // the provider's stable user id (Google `sub`)
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// same shape as email verification. a successful reset also revokes every refresh
// token, which signs them out everywhere
model PasswordResetToken {
  id         String    @id @default(uuid())
  codeHash   String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ========= corpus zone ===============

// a fixed set so the model can't invent its own categories. OTHER is where
// anything that fails validation lands
enum Category {
  HUMAN_FACTORS
  AIRCRAFT_SYSTEMS
  WEATHER
  ATC_COMMUNICATION
  RUNWAY_SAFETY
  WILDLIFE
  PROCEDURAL
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// an admin upload, handled by the worker off the request path. the raw CSV sits
// on the row because the worker is a separate process with no shared disk
model IngestionJob {
  id              String    @id @default(uuid())
  uploaderId      String?
  uploader        User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  filename        String
  status          JobStatus @default(QUEUED)
  totalRows       Int       @default(0)
  reportsIngested Int       @default(0)
  chunksCreated   Int       @default(0)
  error           String?
  sourceCsv       String
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("ingestion_jobs")
}

// one ASRS report, kept word for word so any answer can be traced back to it.
// category and severity are set at ingestion, summary is made on first view and
// cached, so unchanged text never gets summarised twice
model Report {
  id         String    @id @default(uuid())
  // ASRS Accession Number, the report's id in the outside world. unique, so
  // re-ingesting the same CSV upserts rather than duplicating
  acn        String    @unique
  narrative  String
  synopsis   String?
  reportDate DateTime?

  category              Category?
  severity              Severity?
  severityJustification String?
  summary               String?

  chunks ReportChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([severity])
  // the triage list orders by reportDate desc every single load
  @@index([reportDate])
  @@map("reports")
}

// a slice of a narrative plus its vector.
// `embedding` is Unsupported() because prisma has no vector type, so it only ever
// goes in and out through raw SQL, never the typed client. the HNSW index on it
// is written by hand in the migration SQL
model ReportChunk {
  id         String                      @id @default(uuid())
  reportId   String
  report     Report                      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_chunks")
}

// opaque random strings, and we only keep the sha256. revokedAt covers logout and
// rotation on refresh, expiresAt caps how long a session can live
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ========== metrics rollup zone ==============

// one small row per UTC day, written by the nightly worker. this is what lets the
// dashboard show all-time totals without scanning query_logs and token_usage, and
// it's the reason those raw tables can be pruned at all. `day` is "YYYY-MM-DD"
model DailyMetric {
  day              String @id
  queriesSearch    Int    @default(0)
  queriesAsk       Int    @default(0)
  tokensTotal      Int    @default(0)
  tokensPrompt     Int    @default(0)
  tokensCompletion Int    @default(0)
  // { EMBEDDING: n, CHAT: n, REWRITE: n, ... }
  tokensByOperation Json  @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_metrics")
}
