{
  "compilerOptions": {
    // ── Module system: Node-native ESM ("type": "module"). Relative imports
    //    must carry a .js extension, even in .ts source, that's NodeNext.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],

    // ── Emit
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,

    // ── Type safety (keep the strict template defaults)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    // ── Interop / DX
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
