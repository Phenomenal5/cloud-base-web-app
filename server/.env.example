# Nasight API environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Server ────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# Comma-separated allowlist of frontend origins (client + admin). Never a wildcard.
# In production this must be real https origins, or the server refuses to boot.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Externally reachable origin of this API, no /api suffix. Used to build absolute
# avatar URLs. Required in production.
PUBLIC_BASE_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────
# Standard postgresql:// URL (Neon / Supabase).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# pg-boss needs a DIRECT (non-pooled) connection. On Neon, use the host WITHOUT
# "-pooler". Falls back to DATABASE_URL if unset.
# QUEUE_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth ──────────────────────────────────────────────
# Required, and must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30

# ── Email (Brevo transactional API) ───────────────────
# Without a key, codes are logged to the console. That's dev only; in production
# BREVO_API_KEY is required and the server refuses to send without it.
#
# This is the v3 API key (dashboard, SMTP & API, API Keys) starting `xkeysib-`,
# NOT the separate "SMTP key". We use the HTTPS API because PaaS hosts block
# outbound SMTP ports, which makes relay sends hang.
# EMAIL_FROM must be a sender verified in your Brevo account.
BREVO_API_KEY=
EMAIL_FROM=no-reply@nasight.app
EMAIL_FROM_NAME=Nasight
VERIFICATION_CODE_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15

# ── AI / embeddings (OpenAI) ──────────────────────────
# Without a key, embeddings use a deterministic dev fallback: the pipeline runs
# but search isn't semantic. Required in production.
OPENAI_API_KEY=
# 1536 dims, must match the vector size in the Prisma schema.
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_MAX_CHARS=1600
CHUNK_OVERLAP_CHARS=200
# Max reports per CSV upload. Each row costs a classification + an embedding call.
INGESTION_MAX_ROWS=5000

# ── Grounded Q&A ──────────────────────────────────────
# Output-token caps are constants in code, not env vars, so the cost ceiling
# can't be raised through configuration.
CHAT_MODEL=gpt-4o-mini
RETRIEVAL_TOP_N=5
# Raise to around 0.3 with real embeddings, so off-topic questions return nothing
# instead of the nearest weak match.
RETRIEVAL_MIN_SIMILARITY=0
# Prior turns fed to follow-up rewriting.
FOLLOWUP_TURNS=3

# ── Daily query quotas (per UTC day) ──────────────────
QUOTA_TRAINEE_DAILY=30
QUOTA_ANALYST_DAILY=100
# Per IP. Admin is unlimited.
QUOTA_GUEST_DAILY=2

# ── Retention ─────────────────────────────────────────
# Days of raw query_logs / token_usage kept. The nightly worker rolls completed
# days into daily_metrics before pruning, so dashboard totals survive.
METRICS_RETENTION_DAYS=90

# ── Google OAuth ──────────────────────────────────────
# /api/auth/google is disabled unless both of these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered in Google Cloud Console:
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
# Where the browser lands afterwards. The success URL must match the client's
# route, which is /oauth-callback.
# OAUTH_SUCCESS_REDIRECT=http://localhost:3000/oauth-callback
# OAUTH_FAILURE_REDIRECT=http://localhost:3000/login?error=oauth
