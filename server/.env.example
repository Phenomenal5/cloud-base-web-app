# Nasight API — environment template.
# Copy to `.env` and fill in real values. Never commit `.env` (see .gitignore).

# ── Server ────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated allowlist of frontend origins (client + admin). Never wildcard.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ──────────────────────────────────────────
# Standard postgresql:// URL (Neon / Supabase). Prisma 7 reads this for
# CLI/migrate (prisma.config.ts) and for the pg driver adapter at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Background queue (pg-boss). Prefer a DIRECT (non-pooled) URL — on Neon use the
# host WITHOUT "-pooler". Defaults to DATABASE_URL if unset.
# QUEUE_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth ──────────────────────────────────────────────
# Secret for signing access-token JWTs (required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Optional TTLs (defaults shown): access token lifetime, refresh token lifetime.
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30

# ── Email (Brevo SMTP relay) ──────────────────────────
# Without BREVO_SMTP_USER/BREVO_SMTP_KEY, verification codes are logged (dev).
# BREVO_SMTP_USER is the SMTP login (…@smtp-brevo.com); BREVO_SMTP_KEY is the Brevo
# "SMTP key" (dashboard → SMTP & API → SMTP), NOT your login password.
# EMAIL_FROM must be a sender verified in your Brevo account.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM=no-reply@nasight.app
EMAIL_FROM_NAME=Nasight
VERIFICATION_CODE_TTL_MINUTES=15

# ── AI / embeddings (OpenAI) ──────────────────────────
# Without OPENAI_API_KEY, embeddings use a deterministic dev fallback (pipeline
# runs but results aren't semantic). Set the key for real semantic search.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small   # 1536 dims — must match schema vector size
CHUNK_MAX_CHARS=1600
CHUNK_OVERLAP_CHARS=200

# ── Grounded Q&A (streaming) ──────────────────────────
# Without OPENAI_API_KEY, answers come from a dev stub (streaming still works).
CHAT_MODEL=gpt-4o-mini
# NOTE: output-token caps are hard constants in code (FR-18), not env vars.
RETRIEVAL_TOP_N=5
RETRIEVAL_MIN_SIMILARITY=0   # raise (~0.3 real embeddings) for the no-results path

# ── Daily query quotas (per UTC day, search + ask combined) ──
QUOTA_TRAINEE_DAILY=30
QUOTA_ANALYST_DAILY=100
QUOTA_GUEST_DAILY=2          # per IP; admin is unlimited

# ── Added as features land (not required yet) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered in Google Cloud Console:
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
# Where the browser lands after OAuth resolves:
# OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
# OAUTH_FAILURE_REDIRECT=http://localhost:3000/login?error=oauth
